RESEND_API_KEY=re_replace_me
LEAD_TO_EMAIL=service@solivanceelectric.com
LEAD_FROM_EMAIL=Solivance Electric LLC <leads@solivanceelectric.com>

LEADS_BCC_EMAIL=
LEAD_DRY_RUN=false
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GoHighLevel (LeadConnector) CRM sync — leave blank to disable.
# GHL_API_TOKEN: Private Integration token from Settings > Private Integrations.
# GHL_LOCATION_ID: Sub-account / location ID.
# GHL_WEBSITE_LEAD_TAGS: comma-separated tags for the contact (defaults to website-form).
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_API_VERSION=2021-07-28
GHL_WEBSITE_LEAD_TAGS=website-form

# Google Ads (paid landing pages /lp/*). Leave NEXT_PUBLIC_GTM_ID blank to load
# the Ads tag directly with these; set it to load everything through GTM instead.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18539182215
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=ze3aCOzN86odEIfxlYhF

# Upstash Redis (lead dedupe + once-only conversion claim). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
